meta {
  name: 03 Add same laptop again (merge)
  type: http
  seq: 3
}

post {
  url: {{cartServiceUrl}}/carts/{{userId}}/items
  body: json
  auth: none
}

body:json {
  {
    "productId": "{{laptopId}}",
    "quantity": 1,
    "selectedOptions": [
      { "groupCode": "PROCESSOR", "valueCode": "I7" },
      { "groupCode": "RAM", "valueCode": "RAM_32" }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.items.length: eq 1
}
