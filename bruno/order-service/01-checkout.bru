meta {
  name: 01 Checkout
  type: http
  seq: 1
}

post {
  url: {{orderServiceUrl}}/orders/{{userId}}
  body: json
  auth: none
}

body:json {
  {
    "customer": {
      "firstName": "Jan",
      "lastName": "Kowalski",
      "email": "jan@example.com",
      "phone": "+48123456789"
    },
    "deliveryMethod": "COURIER",
    "paymentMethod": "CARD",
    "shippingAddress": {
      "street": "Marszalkowska 1",
      "city": "Warszawa",
      "postalCode": "00-001",
      "country": "PL"
    },
    "expectedTotal": {{cartTotal}}
  }
}

assert {
  res.status: eq 201
  res.body.status: eq NEW
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("orderId", res.body.id);
    bru.setVar("orderNumber", res.body.orderNumber);
  }
}
