meta {
  name: 04 Add To Cart
  type: http
  seq: 5
}

post {
  url: {{interactionServiceUrl}}/api/cart/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "productId": "{{laptopId}}",
    "quantity": 1,
    "selectedOptions": [
      { "groupCode": "PROCESSOR", "valueCode": "I7" },
      { "groupCode": "RAM", "valueCode": "RAM_32" }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.items: isDefined
}
