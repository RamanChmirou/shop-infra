meta {
  name: 08 Submit Order
  type: http
  seq: 9
}

post {
  url: {{interactionServiceUrl}}/api/checkout/submit
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 201
  res.body.status: eq NEW
  res.body.orderNumber: isDefined
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("orderId", res.body.id);
    bru.setEnvVar("orderNumber", res.body.orderNumber);
  }
}
